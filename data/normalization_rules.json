{
  "_comment": "Declarative tuning for the matcher (src/matcher.js). This is the extension point: to fix a naming discrepancy between the tier sheet, PCPartPicker and Tweakers, add data here instead of editing matching code. 'aliases' rewrite incoming product names before tokenizing; 'generic' tokens score low (common marketing words); 'noise' tokens are dropped; 'thresholds' decide badge confidence bands. 'weights.productMissNamed' is the steeper penalty for ignoring a product token that names the model (e.g. 'ELITE') rather than merely describing it.",
  "thresholds": {
    "strong": 0.75,
    "likely": 0.45,
    "floor": 0.45,
    "minProductCoverage": 0.3,
    "ambiguousGap": 0.02
  },
  "weights": {
    "candidateMiss": 0.35,
    "productMiss": 0.2,
    "productMissNamed": 0.6
  },
  "noise": [
    "w",
    "watt",
    "watts",
    "the",
    "with",
    "edition",
    "certified",
    "fully",
    "semi",
    "modular",
    "mod",
    "non",
    "full",
    "power",
    "supply",
    "psu",
    "unit",
    "computer",
    "compact",
    "rating",
    "efficiency",
    "form",
    "factor",
    "atx",
    "atx3",
    "group",
    "hub",
    "fanless",
    "230v",
    "115v",
    "wit",
    "zwart",
    "voeding",
    "geen",
    "met",
    "versie",
    "kabels",
    "connector",
    "poorten",
    "12vhpwr",
    "12v",
    "2x6",
    "retail",
    "bulk",
    "stekker",
    "usb",
    "12vpwr",
    "kabel",
    "pin",
    "pins",
    "niet",
    "modulair",
    "tt"
  ],
  "generic": [
    "gold",
    "bronze",
    "silver",
    "platinum",
    "titanium",
    "white",
    "standard",
    "series",
    "pcie",
    "gen",
    "plus",
    "v",
    "rgb",
    "argb",
    "black",
    "snow",
    "color",
    "colour",
    "vanguard",
    "sfx",
    "tfx",
    "flex"
  ],
  "strip": [
    {
      "pattern": "\\b80\\s*\\+?\\s*plus\\b",
      "replace": "",
      "flags": "ig",
      "note": "'80 Plus' rating prefix"
    },
    {
      "pattern": "\\b80\\s*\\+",
      "replace": "",
      "flags": "ig",
      "note": "'80+' rating prefix (keeps the trailing Gold/Bronze word)"
    },
    {
      "pattern": "\\bgen\\s*[0-9]\\b",
      "replace": "",
      "flags": "ig",
      "note": "'Gen 5' marketing tag"
    },
    {
      "pattern": "\\bversion\\s*[ab]\\s*\\(fnfag.*\\)",
      "replace": "",
      "flags": "ig",
      "note": "Strip 'Version A/B (FNFAG)' from Toughpower GT so base listings match it"
    },
    {
      "pattern": "\\b(?:global\\s*\\(fagk\\-h\\)|swap\\s*\\(fagu\\-l\\))",
      "replace": "",
      "flags": "ig",
      "note": "Strip 'Global' and 'Swap' variants from Toughpower GF A3 so base listings match both"
    },
    {
      "pattern": ",\\s*(?:original|swap)\\s*\\(tpd\\-[a-z]+\\)",
      "replace": "",
      "flags": "ig",
      "note": "Strip 'Original' and 'Swap' variants from Toughpower GF3 Premium so base listings match all"
    },
    {
      "pattern": "\\brev\\.\\s*[12]\\s*\\((?:explosive|fixed)\\)",
      "replace": "",
      "flags": "ig",
      "note": "Strip Rev 1/2 from Gigabyte P-GM so base listings match both"
    },
    {
      "pattern": "\\(eu-stekker\\)",
      "replace": "",
      "flags": "ig",
      "note": "Strip Dutch '(EU-stekker)' plug packaging tag"
    },
    {
      "pattern": "(?<!core\\s+gx\\s*)\\batx\\s*3(?!\\.|\\d)\\b",
      "replace": "",
      "flags": "ig",
      "note": "Strip bare 'ATX 3' standard tags so they don't score as unmatched '3' tokens (preserves Seasonic Core GX ATX 3)"
    },
    {
      "pattern": "\\b(?:cpx-fc|ppg-[a-z]|zpu-s|ae-pm|har-pma?|ha-pt)\\b",
      "replace": "",
      "flags": "ig",
      "note": "Strip internal factory platform codes from Chieftec, Gigabyte, and Silverstone models"
    },
    {
      "pattern": "\\bplat\\.\\s*global\\b",
      "replace": "Platinum",
      "flags": "ig",
      "note": "Normalize 'Plat. Global' in Cooler Master models to Platinum"
    },
    {
      "pattern": "\\b(?:230|115)\\s*v(?:olt)?\\b",
      "replace": "",
      "flags": "ig",
      "note": "Strip input voltage ratings e.g. 230V, 230 Volt, 115V"
    },
    {
      "pattern": "\\((?:gray|grey|black|green)\\s+label[^)]*\\)",
      "replace": "",
      "flags": "ig",
      "note": "Strip Corsair label color descriptors e.g. (Gray Label), (Black Label)"
    },
    {
      "pattern": "\\(rev\\.\\s*\\d+(?:\\.\\d+)?\\)",
      "replace": "",
      "flags": "ig",
      "note": "Strip Gigabyte / vendor revision parentheticals e.g. (rev. 2.0)"
    },
    {
      "pattern": "\\bhatsune\\s+miku\\b",
      "replace": "",
      "flags": "ig",
      "note": "Strip Hatsune Miku special edition branding"
    },
    {
      "pattern": "\\bultra\\s+durable\\b",
      "replace": "",
      "flags": "ig",
      "note": "Gigabyte marketing descriptor; preserves PG5 and variant suffixes as identity evidence."
    },
    {
      "pattern": "\\btt\\s+premium(?:\\s+edition)?\\b",
      "replace": "",
      "flags": "ig",
      "note": "Thermaltake TT Premium marketing phrase; specific GF/TF/SFX identities are retained."
    },
    {
      "pattern": "\\bsfx[\\s-]*l\\b",
      "replace": "SFX",
      "flags": "ig",
      "note": "Form factor is handled as a structured compatibility constraint; avoid treating the L descriptor as a model suffix."
    }
  ],
  "aliases": [
    {
      "pattern": "(\\bvengeance\\s+)(\\d{3,4})m\\b",
      "replace": "$1$2",
      "flags": "ig",
      "note": "Corsair Vengeance wattage-M codes indicate modularity; certification distinguishes Bronze/Silver in the sheet."
    },
    {
      "pattern": "(\\bantec\\s+)ne\\s*(\\d{3,4})g\\s*m\\b",
      "replace": "$1Neo Eco Gold Modular $2",
      "flags": "ig",
      "note": "Antec NE wattage G M is the Neo Eco Gold Modular family."
    },
    {
      "pattern": "(\\brog\\s+thor\\s+)(\\d{3,4})p\\b",
      "replace": "$1$2 Platinum",
      "flags": "ig",
      "note": "ASUS ROG Thor wattage-P is Platinum; this rule preserves explicit P2/P3 generation codes."
    },
    {
      "pattern": "\\battis\\s*(\\d{3,4})r\\b",
      "replace": "ATTIS Bronze $1",
      "flags": "ig",
      "note": "SilverStone ATTIS wattage-R code is named ATTIS Bronze in the sheet."
    },
    {
      "pattern": "(\\bacrux\\b.*?)\\bzm(\\d{3,4})-arx\\b",
      "replace": "$1 $2",
      "flags": "ig",
      "note": "Zalman Acrux redundant ZM wattage ARX SKU."
    },
    {
      "pattern": "\\binter-tech\\s+sama\\b",
      "replace": "SAMA",
      "flags": "ig",
      "note": "Explicit Inter-Tech SAMA reseller label retains the manufacturer named in the sheet."
    },
    {
      "pattern": "\\bsama\\s+xph-(\\d{3,4})a\\b",
      "replace": "SAMA XP XPH-A $1",
      "flags": "ig",
      "note": "SAMA XPH wattage A storefront SKU identifies the XP XPH-A family without asserting V3."
    },
    {
      "pattern": "(\\bwatttera\\b)\\s*\\(ebtii\\)",
      "replace": "$1",
      "flags": "ig",
      "note": "Zalman WattTera EBTII is a redundant storefront family code, not an assertion of Acrux II."
    },
    {
      "pattern": "\\bsl\\s*-\\s*(\\d{3,4})gw\\b",
      "replace": "Steel Legend Gold $1 white",
      "flags": "ig",
      "note": "ASRock SL wattage GW denotes the white Gold variant."
    },
    {
      "pattern": "\\bsst-",
      "replace": "",
      "flags": "ig",
      "note": "SilverStone SST SKU prefix; the actual model code is preserved."
    },
    {
      "pattern": "(\\brog\\s+strix\\s+)(\\d{3,4})p\\b",
      "replace": "$1$2 Platinum",
      "flags": "ig",
      "note": "ASUS ROG Strix wattage-P codes identify the Platinum family, not Aura Gold."
    },
    {
      "pattern": "\\bsx\\s*1000\\s*-\\s*lpt\\b",
      "replace": "SFX-L SX Platinum 1000",
      "flags": "ig",
      "note": "The sheet names the 1000W SX-LPT as SX Platinum, unlike its 700W sibling."
    },
    {
      "pattern": "\\bst(\\d{2,3})f\\s*-\\s*es230\\b",
      "replace": "Strider Essential ST-ES 230V",
      "flags": "ig",
      "note": "The ES230 code identifies the 230V Strider Essential variant."
    },
    {
      "pattern": "(\\baorus\\s+elite\\s+)p(\\d{3,4})\\b",
      "replace": "$1$2",
      "flags": "ig",
      "note": "Aorus Elite storefront P-wattage code is not the unrelated Aorus P-W series."
    },
    {
      "pattern": "\\bud\\s*(\\d{3,4})\\s*([a-z]{2})\\b",
      "replace": "UD-$2 $1",
      "flags": "ig",
      "note": "Split Gigabyte UD wattage codes while preserving suffixes; Ultra Durable is stripped on both sides."
    },
    {
      "pattern": "\\b(\\d{3,4})\\s*g\\b",
      "replace": "$1 gold",
      "flags": "ig",
      "note": "ASUS TUF '850G' suffix denotes Gold efficiency"
    },
    {
      "pattern": "\\bgaming\\b",
      "replace": "",
      "flags": "ig",
      "note": "marketing word, never part of a tier-sheet model name"
    },
    {
      "pattern": "\\bion\\+?\\s*3\\b",
      "replace": "ION V3",
      "flags": "ig",
      "note": "Fractal 'Ion 3' is the sheet's 'ION V3' generation"
    },
    {
      "pattern": "\\bion\\+\\s*2\\b",
      "replace": "ION Plus 2",
      "flags": "ig",
      "note": "Fractal 'Ion+ 2' is the sheet's 'ION Plus 2'"
    },
    {
      "pattern": "\\bsl\\s*-\\s*(\\d{3,4})p\\b",
      "replace": "Steel Legend Platinum $1p",
      "flags": "ig",
      "note": "ASRock SL-P is Steel Legend Platinum"
    },
    {
      "pattern": "\\bsl\\s*-\\s*(\\d{3,4})g\\b",
      "replace": "Steel Legend Gold $1g",
      "flags": "ig",
      "note": "ASRock SL-G is Steel Legend Gold"
    },
    {
      "pattern": "\\bsx\\s*(\\d{3,4})\\s*-\\s*lpt\\b",
      "replace": "SFX-L SX-LPT Platinum $1",
      "flags": "ig",
      "note": "SilverStone's -LPT suffix is SFX-L Platinum; the sheet spells the 700W one 'SX-LPT' but the 1000W one 'SX Platinum'"
    },
    {
      "pattern": "\\bthor\\s*(\\d{3,4})?\\s*p2\\b",
      "replace": "THOR Platinum II $1",
      "flags": "ig",
      "note": "ASUS ROG Thor '1200P2' is the sheet's 'Platinum II' generation"
    },
    {
      "pattern": "\\bthor\\s*(\\d{3,4})?\\s*p3\\b",
      "replace": "THOR Platinum III $1",
      "flags": "ig",
      "note": "ASUS ROG Thor '1000P3' is the sheet's 'Platinum III' generation"
    },
    {
      "pattern": "\\bthor\\s*(\\d{3,4})?\\s*t3\\b",
      "replace": "THOR Titanium III $1",
      "flags": "ig",
      "note": "ASUS ROG Thor '1600T3' is the sheet's 'Titanium III' generation"
    },
    {
      "pattern": "\\bfocus\\s+gx\\b.*\\b(2024|atx\\s*3\\.1)\\b",
      "replace": "Focus V4 GX",
      "flags": "ig",
      "note": "Seasonic Focus GX 2024/ATX 3.1 is V4 GX"
    },
    {
      "pattern": "\\bfocus\\s+gx\\b.*\\b(2023|atx\\s*3\\.0)\\b",
      "replace": "Focus V3 GX",
      "flags": "ig",
      "note": "Seasonic Focus GX 2023/ATX 3.0 is V3 GX"
    },
    {
      "pattern": "\\bpure\\s+power\\s+(\\d+)\\s*m\\b",
      "replace": "Pure Power $1 M",
      "flags": "ig",
      "note": "be quiet! Pure Power generation number + M unspaced"
    },
    {
      "pattern": "\\bhcg\\s*(\\d{3,4})?\\b",
      "replace": "High Current Gamer $1",
      "flags": "ig",
      "note": "Antec HCG abbreviation for High Current Gamer"
    },
    {
      "pattern": "\\bcore\\s+gx\\b.*\\batx\\s*3\\.[01]\\b",
      "replace": "Core GX ATX 3",
      "flags": "ig",
      "note": "Seasonic Core GX ATX 3.1 is the sheet's Core GX ATX 3"
    },
    {
      "pattern": "\\b(gf\\s*a3|smart\\s*bm3|pf3|tf1|gf2|gf3\\s+snow|gf3\\s+argb)\\b.*\\btt\\s+premium(?:\\s+edition)?\\b",
      "replace": "$1",
      "flags": "ig",
      "note": "Strip TT Premium suffix from GF A3, Smart BM3, PF3, TF1, GF2, GF3 Snow/ARGB"
    },
    {
      "pattern": "\\bst(\\d{2,3})f\\s*-\\s*es\\b",
      "replace": "Strider Essential ST-ES",
      "flags": "ig",
      "note": "SilverStone ST50F-ES model number is Strider Essential ST-ES"
    },
    {
      "pattern": "\\bcsk\\s*(pro)?\\b",
      "replace": "Cuprum Strike $1",
      "flags": "ig",
      "note": "Antec CSK is Cuprum Strike"
    },
    {
      "pattern": "\\bda\\s*(\\d{3,4})?\\s*r(?:\\s+gold)?\\b",
      "replace": "Decathlon DA-R $1",
      "flags": "ig",
      "note": "SilverStone DA-R Gold title identifies the DA-R family, not its GM/GMA platform revision."
    },
    {
      "pattern": "\\bplatimax\\s*ii\\b|\\bplatimaxii\\b",
      "replace": "Platimax II",
      "flags": "ig",
      "note": "Normalize PlatimaxII to Platimax II"
    },
    {
      "pattern": "\\b(\\d{3,4})\\s*df\\b",
      "replace": "$1 D.F.",
      "flags": "ig",
      "note": "Enermax 1200DF is 1200 D.F."
    },
    {
      "pattern": "\\bmet\\s*\\d+-pins\\b|\\(met\\s*\\d+-pins[^)]*\\)",
      "replace": "",
      "flags": "ig",
      "note": "Strip Dutch cable accessory notes like (met16-pins kabel)"
    },
    {
      "pattern": "\\brotational\\s+shift\\b",
      "replace": "RS-G",
      "flags": "ig",
      "note": "Lian Li Rotational Shift matches sheet model RS-G"
    },
    {
      "pattern": "\\btc\\s*-\\s*(\\d{3,4})t\\b",
      "replace": "$1",
      "flags": "ig",
      "note": "ASRock Taichi TC-T model code (e.g. TC-1650T)"
    },
    {
      "pattern": "\\bsf\\s*(\\d{3,4})?\\s*\\(?2018\\)?\\b",
      "replace": "SF Platinum 2019 $1",
      "flags": "ig",
      "note": "Corsair SF (2018) is sheet SF Platinum 2019"
    },
    {
      "pattern": "\\bsp\\s*0?(\\d{3,4})\\s*p\\b",
      "replace": "SP -P Platinum $1",
      "flags": "ig",
      "note": "Lian Li SP-P Platinum (e.g. SP0850P)"
    },
    {
      "pattern": "\\bcp-psu-vt-(\\d{3,4}w?-)?",
      "replace": "",
      "flags": "ig",
      "note": "Vetroo model code prefix (e.g. CP-PSU-VT-850W-SFX)"
    },
    {
      "pattern": "\\((?:bk|wt|pk|wh|black|white|pink)\\)",
      "replace": "",
      "flags": "ig",
      "note": "Strip packaging color tags like (BK), (WT), (PK)"
    },
    {
      "pattern": "\\brb\\b(?!-)",
      "replace": "RB-B",
      "flags": "ig",
      "note": "Lian Li RB is sheet RB-B"
    }
  ],
  "identity": {
    "variantWords": [
      "rgb",
      "argb",
      "snow",
      "noctua",
      "ice",
      "shift",
      "ve",
      "elite",
      "core"
    ],
    "revisionWords": [
      "new",
      "old",
      "se"
    ],
    "revisionPatterns": [
      {
        "pattern": "\\bdc-dc\\s+ver\\b",
        "value": "dc-dc"
      },
      {
        "pattern": "\\bcircular\\s+fan\\s+grille\\b",
        "value": "circular fan grille"
      },
      {
        "pattern": "\\bdecathlon\\s+da-r\\s+(gma?)\\b",
        "group": 1
      }
    ],
    "variantPatterns": [
      {
        "pattern": "\\bd\\.\\s*f\\.",
        "value": "d.f."
      }
    ],
    "familyNoise": [
      "new",
      "old",
      "se",
      "dc",
      "ver"
    ]
  }
}
