{
  "name": "psu-tier-userscript",
  "version": "2.0.18",
  "description": "Userscript that shows SPL's PSU Tier List ratings on PCPartPicker and Tweakers.",
  "license": "GPL-3.0-only",
  "private": true,
  "scripts": {
    "test": "node tools/check.cjs --test",
    "test:matching": "node tests/test_matching.js",
    "test:adapters": "node tests/test_adapters.js",
    "test:coverage": "node tests/test_coverage.js",
    "lint": "eslint .",
    "typecheck": "tsc -p jsconfig.json",
    "check": "node tools/check.cjs",
    "test:browser": "node tools/check.cjs --browser",
    "test:python": "python -m unittest discover -s tests -p test_*.py",
    "test:benchmark": "node tools/benchmark.cjs",
    "snapshot:refresh": "python snapshot.py --refresh",
    "validate:release": "python test_suite.py --release",
    "capture": "node tools/live_capture.mjs --capture",
    "smoke": "node tools/live_capture.mjs --smoke",
    "audit:tweakers": "node tools/audit_tweakers.mjs",
    "audit:pcpp": "node tools/audit_pcpp.mjs --auto",
    "icons": "node tools/generate_icons.mjs",
    "screenshots": "node tools/convert_screenshots.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.2",
    "eslint": "^10.4.1",
    "globals": "^17.6.0",
    "linkedom": "^0.18.5",
    "playwright": "^1.48.0",
    "typescript": "^6.0.3"
  }
}
